# ==============================================================================
# Git Ignore Configuration - ICU Mortality Risk Prediction Project
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Datasets & Large Preprocessed Arrays (1.8 GB PhysioNet 2012 Data)
# ------------------------------------------------------------------------------
# Full raw dataset folder containing thousands of patient records and archives
Dataset/
Dataset/*

# Preprocessed NumPy binary tensors, arrays, and matrix archives (>1.4 GB)
*.npy
*.npz
data/raw/
data/processed/**/*.npy
data/processed/**/*.npz

# Whitelist essential small scalers, feature metadata, and dataset documentation
!data/README.md
!data/processed/**/scaler_*.joblib
!data/processed/**/tabular_feature_metadata.json
!data/processed/**/feature_names.json

